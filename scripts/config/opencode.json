{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "claude-code": {
      "name": "Claude Code"
    }
  },
  "plugins": [
    "file:///home/josuegalre/projects/opencode-claude",
    {
      "package": "file:///home/josuegalre/projects/opencode-v1-compat/dist",
      "options": {
        "plugins": [
          "opencode-pty",
          "file:///home/josuegalre/projects/opencode-v1-compat/vendor/rtk.ts"
        ]
      }
    },
    "file:///home/josuegalre/projects/reparto/scripts/fault-plugin",
    {
      "package": "file:///home/josuegalre/projects/reparto",
      "options": {
        "config": "/tmp/reparto-dev/reparto.jsonc"
      }
    },
    {
      "package": "@plannotator/opencode@0.27.19",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan"
        ]
      }
    }
  ],
  "permissions": [
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "grep_app_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "explore": {
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "codegraph_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}
