{
  "name": "reparto",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --target bun --outfile dist/server.js server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.js .",
    "lint:fix": "oxlint -c oxlint.config.js . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.18"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "1.3.11",
    "eslint-plugin-perfectionist": "^5.10.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "5.9.3"
  }
}
